---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto mb-14 max-w-2xl text-center">
  <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">{eyebrow}</p>
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 leading-relaxed text-muted-foreground">{description}</p>}
</div>
