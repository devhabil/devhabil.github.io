---
import SectionHeading from './SectionHeading.astro';

const experiences = [
  {
    role: 'Software Engineer',
    company: 'PT Bamiraci',
    type: 'Contract',
    period: 'Jul 2025 — Jan 2026',
    description:
      'Architected a monolithic internal management system using Java, Spring Boot, and PostgreSQL.',
  },
  {
    role: 'Independent Backend Developer',
    company: 'Freelance',
    type: 'Self-employed',
    period: 'Sep 2024 — Jan 2026',
    description: 'Developed custom RESTful APIs and designed normalized PostgreSQL/MySQL schemas.',
  },
  {
    role: 'Backend Java Trainee',
    company: 'SYNRGY Academy & BCA',
    type: 'Bootcamp',
    period: 'Mar 2024 — Aug 2024',
    description: 'Engineered SATU Banking, an enterprise-grade core banking API system.',
  },
];
---

<section id="experience" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      eyebrow="Experience"
      title="Work Experience"
      description="Where I have worked and what I have built along the way."
    />

    <ol class="relative mx-auto ml-2 max-w-3xl space-y-10 border-l border-border">
      {
        experiences.map((exp) => (
          <li class="relative pl-8">
            <span class="absolute -left-[6px] top-1.5 h-3 w-3 rounded-full border-2 border-primary bg-background" />
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="text-base font-semibold tracking-tight">{exp.role}</h3>
              <span class="text-sm font-medium text-primary">· {exp.company}</span>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
              <span class="rounded-full border border-border bg-secondary/60 px-3 py-1 font-medium">
                {exp.period}
              </span>
              <span>{exp.type}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{exp.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
