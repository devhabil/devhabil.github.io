---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      eyebrow="Projects"
      title="Featured Projects"
      description="Selected case studies of systems I have designed and engineered."
    />

    <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <ProjectCard
            project={project}
            wide={projects.length % 2 === 1 && i === projects.length - 1}
          />
        ))
      }
    </div>
  </div>
</section>
