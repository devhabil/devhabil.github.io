---
import Badge from './Badge.astro';

const skills = [
  'Java',
  'Golang',
  'Python',
  'SQL',
  'TypeScript',
  'Spring Boot',
  'Gin',
  'React.js',
  'AWS',
  'Docker',
  'PostgreSQL',
  'Redis',
];
---

<section id="skills" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">Skills</p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Technologies &amp; Tools</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        The stack I use to design, build, and ship backend systems — from language to infrastructure.
      </p>
    </div>

    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-3">
      {skills.map((skill) => <Badge text={skill} size="md" />)}
    </div>
  </div>
</section>
